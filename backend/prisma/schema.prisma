datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ──────────────────────────────────────────
// Enums
// ──────────────────────────────────────────

enum UserRole {
  BIS_CDR
  BRANCH_COORD
  TEAM_LEADER
  TRAINEE
  UNIT_TRAINING // מדור הדרכה יחידתי - 4th approval authority
}

enum CourseType {
  FOUNDATION
  ADVANCED
  LEADERSHIP
}

enum CourseInstanceStatus {
  DRAFT
  OPEN
  IN_PROGRESS
  COMPLETED
}

enum PhaseType {
  CANDIDACY_SUBMISSION
  TRYOUTS
  COMMANDER_COURSE
  STAFF_PREP
  COURSE
  SUMMARY_WEEK
  OTHER
}

enum CandidacyStatus {
  PENDING
  COORD_REVIEWED
  APPROVED
  REJECTED
}

enum RegistrationStatus {
  PENDING_TL            // Step 1: waiting for team leader (ראש צוות)
  PENDING_COORD         // Step 2: waiting for branch coord (קה"ד ענפי)
  PENDING_BIS           // Step 3: waiting for school commander (מפקד בי"ס)
  APPROVED
  REJECTED
}

enum AggregateType {
  USER
  COURSE
  COURSE_INSTANCE
  COURSE_PHASE
  CANDIDACY
  REGISTRATION
}

enum ServiceType {
  KEVA      // קבע - career military
  MANDATORY // חובה - mandatory service
}

// ──────────────────────────────────────────
// Organizational Structure
// ──────────────────────────────────────────

model Branch {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(128)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  teams Team[]
  users User[]
}

model Team {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(128)
  branchId  Int
  branch    Branch   @relation(fields: [branchId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]
}

model User {
  id        Int      @id @default(autoincrement())
  uniqueId  String   @unique @db.VarChar(64)
  name      String   @db.VarChar(128)
  role      UserRole
  teamId    Int?
  team      Team?    @relation(fields: [teamId], references: [id])
  branchId  Int?
  branch    Branch?  @relation(fields: [branchId], references: [id])
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  candidaciesAsCandidate  CommandCandidacy[]   @relation("CandidateUser")
  candidaciesAsSubmitter  CommandCandidacy[]   @relation("SubmitterUser")
  candidacyReviews        CommandCandidacy[]   @relation("ReviewerUser")
  registrations           CourseRegistration[] @relation("RegistrantUser")
  tlApprovals             CourseRegistration[] @relation("TlApprover")
  coordApprovals          CourseRegistration[] @relation("CoordApprover")
  bisApprovals            CourseRegistration[] @relation("BisApprover")
  unitTrainingApprovals   CourseRegistration[] @relation("UnitTrainingApprover")
  eventLogs               EventLog[]
  eventsAsActor           Event[]              @relation("EventActor")
  uploadedFiles           AttachedFile[]       @relation("FileUploader")

  // Optional soldier profile - only populated for TRAINEE role
  soldierProfile SoldierProfile?
}

// ──────────────────────────────────────────
// Soldier Profile (gamush hours & service)
// ──────────────────────────────────────────

model SoldierProfile {
  id                    Int         @id @default(autoincrement())
  userId                Int         @unique
  user                  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceType           ServiceType
  // Months remaining in mandatory service (null for KEVA)
  remainingServiceMonths Int?
  // Gamush (גמיש) hours tracking
  gamushHoursCompleted  Int         @default(0)
  gamushHoursRequired   Int         @default(0)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt
}

// ──────────────────────────────────────────
// Budget (advanced course budget per year)
// ──────────────────────────────────────────

model Budget {
  id          Int      @id @default(autoincrement())
  year        Int      // e.g. 2026
  totalAmount Decimal  @db.Decimal(12, 2)
  usedAmount  Decimal  @default(0) @db.Decimal(12, 2)
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([year])
}

// ──────────────────────────────────────────
// Course Catalog & Gantt
// ──────────────────────────────────────────

model Course {
  id           Int        @id @default(autoincrement())
  name         String     @db.VarChar(256)
  description  String     @db.Text
  type         CourseType
  requirements String?    @db.Text
  gmushHours   Int?
  location     String?    @db.VarChar(256)
  isPublished  Boolean    @default(false)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  instances     CourseInstance[]
  formTemplates FormTemplate[]
}

model CourseInstance {
  id        Int                  @id @default(autoincrement())
  courseId  Int
  course    Course               @relation(fields: [courseId], references: [id])
  name      String               @db.VarChar(128)
  startDate DateTime
  endDate   DateTime
  status    CourseInstanceStatus @default(DRAFT)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  phases        CoursePhase[]
  candidacies   CommandCandidacy[]
  registrations CourseRegistration[]
}

model CoursePhase {
  id               Int            @id @default(autoincrement())
  courseInstanceId Int
  courseInstance   CourseInstance @relation(fields: [courseInstanceId], references: [id], onDelete: Cascade)
  name             String         @db.VarChar(128)
  phaseType        PhaseType
  startDate        DateTime
  endDate          DateTime
  description      String?        @db.Text
  sortOrder        Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

// ──────────────────────────────────────────
// Foundation: Command Candidacy
// ──────────────────────────────────────────

model CommandCandidacy {
  id               Int             @id @default(autoincrement())
  courseInstanceId Int
  courseInstance   CourseInstance  @relation(fields: [courseInstanceId], references: [id])
  candidateId      Int
  candidate        User            @relation("CandidateUser", fields: [candidateId], references: [id])
  submittedById    Int
  submittedBy      User            @relation("SubmitterUser", fields: [submittedById], references: [id])
  status           CandidacyStatus @default(PENDING)
  motivation       String?         @db.Text
  commanderNotes   String?         @db.Text
  formData         Json?
  reviewedById     Int?
  reviewedBy       User?           @relation("ReviewerUser", fields: [reviewedById], references: [id])
  reviewNotes      String?         @db.Text
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  files AttachedFile[] @relation("CandidacyFiles")

  @@unique([courseInstanceId, candidateId])
}

// ──────────────────────────────────────────
// Advanced: Course Registration
// ──────────────────────────────────────────

model CourseRegistration {
  id               Int                @id @default(autoincrement())
  courseInstanceId Int
  courseInstance   CourseInstance     @relation(fields: [courseInstanceId], references: [id])
  userId           Int
  user             User               @relation("RegistrantUser", fields: [userId], references: [id])
  status           RegistrationStatus @default(PENDING_TL)
  formData         Json?

  // Step 1: Team Leader
  tlApprovedById Int?
  tlApprovedBy   User?     @relation("TlApprover", fields: [tlApprovedById], references: [id])
  tlApprovedAt   DateTime?
  tlNotes        String?   @db.Text

  // Step 2: Branch Coordinator
  coordApprovedById Int?
  coordApprovedBy   User?     @relation("CoordApprover", fields: [coordApprovedById], references: [id])
  coordApprovedAt   DateTime?
  coordNotes        String?   @db.Text
  coordPriority     Int?      // תיעדוף ענפי

  // Step 3: BIS Commander
  bisApprovedById Int?
  bisApprovedBy   User?     @relation("BisApprover", fields: [bisApprovedById], references: [id])
  bisApprovedAt   DateTime?
  bisNotes        String?   @db.Text

  // Step 4: Unit Training (מדור הדרכה יחידתי)
  unitTrainingApprovedById Int?
  unitTrainingApprovedBy   User?     @relation("UnitTrainingApprover", fields: [unitTrainingApprovedById], references: [id])
  unitTrainingApprovedAt   DateTime?
  unitTrainingNotes        String?   @db.Text

  // Rejection (any stage)
  rejectionReason String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  files AttachedFile[] @relation("RegistrationFiles")

  @@unique([courseInstanceId, userId])
}

// ──────────────────────────────────────────
// File Attachments (generic - serves both registrations and candidacies)
// ──────────────────────────────────────────

model AttachedFile {
  id             Int                @id @default(autoincrement())
  registrationId Int?
  registration   CourseRegistration? @relation("RegistrationFiles", fields: [registrationId], references: [id], onDelete: Cascade)
  candidacyId    Int?
  candidacy      CommandCandidacy?  @relation("CandidacyFiles", fields: [candidacyId], references: [id], onDelete: Cascade)
  filename       String             @db.VarChar(256)
  originalName   String             @db.VarChar(256)
  mimeType       String             @db.VarChar(128)
  size           Int
  storagePath    String             @db.VarChar(512)
  uploadedById   Int
  uploadedBy     User               @relation("FileUploader", fields: [uploadedById], references: [id])
  expiresAt      DateTime?
  createdAt      DateTime           @default(now())

  @@index([registrationId])
  @@index([candidacyId])
}

// ──────────────────────────────────────────
// Forms & Info
// ──────────────────────────────────────────

model FormTemplate {
  id         Int      @id @default(autoincrement())
  courseId   Int?
  course     Course?  @relation(fields: [courseId], references: [id])
  type       String   @db.VarChar(32) @default("registration") // "registration" | "candidacy"
  name       String   @db.VarChar(128)
  fields     Json     // array of { name, label, type, required }
  pdfPath    String?  @db.VarChar(512) // S3 path to downloadable PDF template
  pdfName    String?  @db.VarChar(256) // original filename
  isRequired Boolean  @default(true)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model InfoPage {
  id          Int      @id @default(autoincrement())
  slug        String   @unique @db.VarChar(128)
  title       String   @db.VarChar(256)
  content     String   @db.Text
  sortOrder   Int      @default(0)
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ──────────────────────────────────────────
// Audit Log
// ──────────────────────────────────────────

model EventLog {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id])
  action     String   @db.VarChar(64)
  entityType String   @db.VarChar(64)
  entityId   Int?
  details    Json?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// ──────────────────────────────────────────
// Event log (append-only)
// ──────────────────────────────────────────

model Event {
  id               BigInt        @id @default(autoincrement())
  eventType        String        @db.VarChar(64)
  aggregateType    AggregateType
  aggregateId      Int
  actorUserId      Int?
  actor            User?         @relation("EventActor", fields: [actorUserId], references: [id])
  payload          Json
  version          Int
  flowId           String?       @db.Uuid
  causationEventId BigInt?
  causationEvent   Event?        @relation("EventCausation", fields: [causationEventId], references: [id])
  causedEvents     Event[]       @relation("EventCausation")
  occurredAt       DateTime      @default(now())

  @@unique([aggregateType, aggregateId, version])
  @@index([aggregateType, aggregateId, occurredAt])
  @@index([eventType, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([flowId])
}
